# Supabase
# Ambil dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Sign-In (WAJIB — login Google gagal / app menampilkan layar error jika kosong)
# Ambil dari Google Cloud Console > APIs & Services > Credentials
# GOOGLE_WEB_CLIENT_ID dipakai sebagai serverClientId di auth_service.dart
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here
